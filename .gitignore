# OS / editor noise
.DS_Store
Thumbs.db
*.swp
*.swo
*~
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# Jekyll / GitHub Pages local build output
_site/
.sass-cache/
.jekyll-cache/
.jekyll-metadata
.bundle/
vendor/
Gemfile.lock

# Node / frontend tooling, if added later
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Python / helper scripts, if added later
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
.venv/
venv/

# Local env and credentials — never commit real secrets
.env
.env.*
!.env.example
.envrc
*.local
*.secret
*.secrets
secrets.*
credentials.*
*.pem
*.key
*.p8
*.p12
*.crt
*.cer
id_rsa*
id_ed25519*
*_rsa
*_ed25519
*service-account*.json
*credentials*.json
*token*.json

# Tool outputs / temporary reports
gitleaks-report.*
*.sarif
tmp/
temp/
.cache/
